<Window x:Class="AccountingAssistant.App.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation"
        Width="560"
        MinHeight="230"
        MaxHeight="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="8"
                              Direction="270"
                              Opacity="0.18"
                              Color="#30445F" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="20,16,14,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PromptTitleTextBlock"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           FontSize="{StaticResource FontSizePanelTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Grid.Column="1"
                        Content="×"
                        Width="30"
                        Height="30"
                        Padding="0"
                        FontSize="18"
                        FontWeight="Normal"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,18,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Top"
                        Background="{StaticResource WarningSoftBrush}"
                        CornerRadius="20">
                    <TextBlock Text="!"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" />
                </Border>

                <TextBox x:Name="PromptMessageTextBox"
                         Grid.Column="1"
                         Margin="14,0,0,0"
                         MinHeight="42"
                         MaxHeight="360"
                         Padding="0"
                         Style="{x:Null}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="{StaticResource AppFontFamily}"
                         FontSize="{StaticResource FontSizeBodyLarge}"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         CaretBrush="{StaticResource AccentBrush}"
                         SelectionBrush="{StaticResource AccentSoftBrush}"
                         SelectionTextBrush="{StaticResource TextPrimaryBrush}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" />
            </Grid>

            <Border Grid.Row="2"
                    Padding="20,14"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CopyActionButton"
                            Grid.Column="0"
                            Content="Copy instructions"
                            Width="140"
                            Height="34"
                            Visibility="Collapsed"
                            Click="CopyActionButton_Click" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="SecondaryActionButton"
                                Width="116"
                                Height="34"
                                IsCancel="True"
                                Click="SecondaryActionButton_Click" />
                        <Button x:Name="PrimaryActionButton"
                                Width="116"
                                Height="34"
                                Margin="8,0,0,0"
                                IsDefault="True"
                                Click="PrimaryActionButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
