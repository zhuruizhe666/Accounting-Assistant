<Window x:Class="AccountingAssistant.App.ExcelExportReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Excel Export"
        Height="650"
        Width="1000"
        MinHeight="540"
        MinWidth="840"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ExportColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ExportCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExportCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBorder"
                                Width="18"
                                Height="18"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1.5"
                                CornerRadius="4">
                            <Path x:Name="CheckMark"
                                  Width="10"
                                  Height="8"
                                  Data="M 1,4 L 4,7 L 9,1"
                                  Stroke="{StaticResource AccentContrastBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Review Excel export"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           FontSize="{StaticResource FontSizePageTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Choose exactly which approved receipts will be appended to the workbook."
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="10,5"
                    VerticalAlignment="Top"
                    Background="{StaticResource SuccessSoftBrush}"
                    CornerRadius="12">
                <TextBlock Text="Ready to export"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SuccessBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14,12"
                Style="{StaticResource WorkspacePanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TARGET WORKBOOK"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Margin="0,4,12,0"
                             Padding="0"
                             MinHeight="0"
                             Text="{Binding TargetPath, Mode=OneWay}"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <Button x:Name="CopyPathButton"
                        Grid.Column="1"
                        MinWidth="82"
                        VerticalAlignment="Center"
                        Content="Copy path"
                        Style="{StaticResource CompactGhostButtonStyle}"
                        Click="CopyPathButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Margin="0,12" Background="{StaticResource BorderBrush}" />
                <Border Grid.Column="3" Margin="0,12" Background="{StaticResource BorderBrush}" />
                <Border Grid.Column="5" Margin="0,12" Background="{StaticResource BorderBrush}" />

                <StackPanel Grid.Column="0" Margin="16,12">
                    <TextBlock Text="APPROVED" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding TotalCount}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="16,12">
                    <TextBlock Text="NEW DOCUMENTS" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding NewCount}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="16,12">
                    <TextBlock Text="DUPLICATES" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding DuplicateCount}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="16,12">
                    <TextBlock Text="SELECTED" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedCount}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,0,0,12"
                Padding="12,9"
                Background="{StaticResource WarningSoftBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSmall}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDuplicates}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="!"
                           Width="20"
                           Height="20"
                           TextAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{StaticResource WarningBrush}" />
                <TextBlock Grid.Column="1"
                           Margin="6,0,0,0"
                           Text="Duplicate document numbers are unchecked by default. Review them before including any existing values again."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource WarningBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ColumnHeaderStyle="{StaticResource ExportColumnHeaderStyle}"
                      CellStyle="{StaticResource ExportCellStyle}"
                      RowStyle="{StaticResource ExportRowStyle}"
                      Background="{StaticResource SurfaceBrush}"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="APPEND" Width="76">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding ShouldAppend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ExportCheckBoxStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="STATUS" Width="112" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBadge"
                                        HorizontalAlignment="Left"
                                        Padding="8,3"
                                        Background="{StaticResource SuccessSoftBrush}"
                                        CornerRadius="10">
                                    <TextBlock x:Name="StatusText"
                                               Text="{Binding DuplicateStatus}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDuplicateDocumentNumber}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="单号" Binding="{Binding DocumentNumber}" IsReadOnly="True" Width="145" />
                    <DataGridTextColumn Header="文件" Binding="{Binding FileName}" IsReadOnly="True" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="日期" Binding="{Binding IssueDate}" IsReadOnly="True" Width="105" />
                    <DataGridTextColumn Header="金额" Binding="{Binding TotalAmount}" IsReadOnly="True" Width="100" />
                    <DataGridTextColumn Header="交易方" Binding="{Binding Counterparty}" IsReadOnly="True" Width="145" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="New only"
                        MinWidth="86"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AppendNewOnlyButton_Click" />
                <Button Content="Select all"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="AppendAllButton_Click" />
                <Button Content="Clear"
                        MinWidth="66"
                        Margin="4,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="AppendNoneButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel"
                        MinWidth="82"
                        IsCancel="True"
                        Style="{StaticResource GhostButtonStyle}" />
                <Button Content="{Binding ExportButtonText}"
                        MinWidth="148"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        IsEnabled="{Binding CanExport}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ExportSelectedButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
