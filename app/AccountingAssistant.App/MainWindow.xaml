<Window x:Class="AccountingAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounting Assistant" Height="760" Width="1160" MinHeight="640" MinWidth="980"
        SizeChanged="Window_SizeChanged">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding ConfirmOcrCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApproveFieldsCommand}" />
        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding NextReceiptCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SelectImagesButton" Content="Select Images" Width="120" Height="34" Click="SelectImagesButton_Click" />
                    <Button x:Name="SelectFolderButton" Content="Select Folder" Width="120" Height="34" Margin="8,0,0,0" Click="SelectFolderButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AnalyzeButton" Content="Analyze" Width="120" Height="34" Click="AnalyzeButton_Click" />
                    <Button x:Name="AnalyzeAllPendingButton" Content="Analyze All" Width="120" Height="34" Margin="8,0,0,0" Click="AnalyzeAllPendingButton_Click" />
                    <Button x:Name="BatchFillButton" Content="Batch Fill" Width="120" Height="34" Margin="8,0,0,0" Click="BatchFillButton_Click" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555555" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Receipt Queue" Margin="0,0,12,0">
                <ListBox x:Name="ImageListBox" SelectionMode="Extended" SelectionChanged="ImageListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="10"
                                         Height="10"
                                         Fill="{Binding StatusBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               Foreground="#666666"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Background="#FAFAFA">
                <ScrollViewer x:Name="ReceiptScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="ReceiptScrollViewer_SizeChanged">
                    <Grid x:Name="ReceiptImageHost"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Image x:Name="ReceiptImage"
                               Stretch="Fill"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" />
                        <Canvas x:Name="OcrOverlayCanvas"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="True" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <GroupBox Grid.Column="2" Header="Review Panel" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TabControl Grid.Row="0">
                        <TabItem Header="OCR">
                            <ListBox x:Name="OcrResultListBox"
                                     SelectionChanged="OcrResultListBox_SelectionChanged"
                                     MouseDoubleClick="OcrResultListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Index}"
                                                       Foreground="#777777"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       Margin="4,0,8,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ConfidenceText}"
                                                       Foreground="#555555"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CorrectionStatus}"
                                                       Foreground="#8A6500"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Fields">
                            <ListBox x:Name="FieldReviewListBox"
                                     SelectionChanged="FieldReviewListBox_SelectionChanged"
                                     PreviewMouseLeftButtonDown="FieldReviewListBox_PreviewMouseLeftButtonDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6"
                                              MinHeight="36">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       Foreground="#555555"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="0"
                                                      Grid.Column="1"
                                                      Width="160"
                                                      MinHeight="30"
                                                      Padding="6,2"
                                                      HorizontalContentAlignment="Stretch"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding Suggestions}"
                                                      Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      LostFocus="FieldValueComboBox_LostFocus"
                                                      SelectionChanged="FieldValueComboBox_SelectionChanged">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                                <Setter Property="BorderBrush" Value="Red" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding ReviewNote}"
                                                       FontSize="11"
                                                       Foreground="#777777"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>

                    <Expander Grid.Row="1"
                              Header="Debug Dump"
                              IsExpanded="False"
                              Margin="0,8,0,0">
                        <TextBox x:Name="DebugDumpTextBox"
                                 Height="180"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                </Grid>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#777777"
                       Text="Shift+Enter confirms OCR review. Ctrl+Enter approves fields. Shift+Down moves to next receipt." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NextReceiptButton"
                        Content="Next Receipt"
                        Width="130"
                        Height="34"
                        Click="NextReceiptButton_Click" />
                <Button x:Name="ConfirmOcrButton"
                        Content="Confirm OCR"
                        Width="130"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="ConfirmOcrButton_Click" />
                <Button x:Name="ApproveFieldsButton"
                        Content="Approve Fields"
                        Width="130"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="ApproveFieldsButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
