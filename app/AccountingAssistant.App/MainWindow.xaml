<Window x:Class="AccountingAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounting Assistant" Height="760" Width="1160" MinHeight="640" MinWidth="980">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding MarkCensoredCommand}" />
        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding NextReceiptCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SelectImagesButton" Content="Select Images" Width="120" Height="34" Click="SelectImagesButton_Click" />
                    <Button x:Name="SelectFolderButton" Content="Select Folder" Width="120" Height="34" Margin="8,0,0,0" Click="SelectFolderButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AnalyzeButton" Content="Analyze Mock" Width="120" Height="34" Click="AnalyzeButton_Click" />
                    <Button x:Name="AnalyzeAllPendingButton" Content="Analyze All" Width="120" Height="34" Margin="8,0,0,0" Click="AnalyzeAllPendingButton_Click" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555555" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Receipt Queue" Margin="0,0,12,0">
                <ListBox x:Name="ImageListBox" SelectionChanged="ImageListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="10"
                                         Height="10"
                                         Fill="{Binding StatusBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               Foreground="#666666"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Background="#FAFAFA">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="ReceiptImage" Stretch="Uniform" />
                </ScrollViewer>
            </Border>

            <GroupBox Grid.Column="2" Header="Worker Result" Margin="12,0,0,0">
                <TextBox x:Name="ResultTextBox"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#777777"
                       Text="Shift+Enter marks censored. Shift+Down moves to next receipt." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NextReceiptButton"
                        Content="Next Receipt"
                        Width="130"
                        Height="34"
                        Click="NextReceiptButton_Click" />
                <Button x:Name="MarkCensoredButton"
                        Content="Mark Censored"
                        Width="130"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="MarkCensoredButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
