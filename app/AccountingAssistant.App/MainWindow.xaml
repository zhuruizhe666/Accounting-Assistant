<Window x:Class="AccountingAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounting Assistant"
        Height="760"
        Width="1160"
        MinHeight="640"
        MinWidth="980"
        Background="{StaticResource WorkspaceAmbientBrush}"
        SizeChanged="Window_SizeChanged">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding ConfirmOcrCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApproveFieldsCommand}" />
        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding NextReceiptCommand}" />
        <KeyBinding Key="O" Modifiers="Shift" Command="{Binding ShowOcrTabCommand}" />
        <KeyBinding Key="F" Modifiers="Shift" Command="{Binding ShowFieldsTabCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12,10"
                    Style="{StaticResource WorkspacePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Add receipts" Style="{StaticResource CommandGroupLabelStyle}" />
                        <Button x:Name="SelectImagesButton"
                                Content="Select Images"
                                Width="116"
                                Height="34"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SelectImagesButton_Click" />
                        <Button x:Name="SelectFolderButton"
                                Content="Select Folder"
                                Width="116"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="SelectFolderButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Process" Style="{StaticResource CommandGroupLabelStyle}" />
                        <Button x:Name="AnalyzeButton"
                                Content="Analyze"
                                Width="104"
                                Height="34"
                                Style="{StaticResource PendingActionButtonStyle}"
                                Click="AnalyzeButton_Click" />
                        <Button x:Name="AnalyzeAllPendingButton"
                                Content="Analyze All"
                                Width="104"
                                Height="34"
                                Margin="8,0,0,0"
                                Style="{StaticResource PendingActionButtonStyle}"
                                Click="AnalyzeAllPendingButton_Click" />
                        <Button x:Name="BatchFillButton"
                                Content="Batch Fill"
                                Width="104"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="BatchFillButton_Click" />
                        <Button x:Name="ExportExcelButton"
                                Content="Export Excel"
                                Width="104"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="ExportExcelButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14,10"
                    Style="{StaticResource WorkspacePanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="2" />
                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Current status"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Main workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Receipt queue -->
            <Border x:Name="ReceiptQueuePanel"
                    Grid.Column="0"
                    AllowDrop="True"
                    PreviewDragEnter="ReceiptQueue_DragEnter"
                    PreviewDragOver="ReceiptQueue_DragOver"
                    PreviewDragLeave="ReceiptQueue_DragLeave"
                    PreviewDrop="ReceiptQueue_Drop"
                    Style="{StaticResource WorkspaceColumnPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,13,10,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="SortQueueButton"
                                    Content="Sort"
                                    Style="{StaticResource CompactGhostButtonStyle}"
                                    Click="SortQueueButton_Click" />
                            <Button x:Name="RemoveReceiptsButton"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource CompactDangerIconButtonStyle}"
                                    ToolTip="Remove selected receipts"
                                    Click="RemoveReceiptsButton_Click">
                                <Path Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 2,4 L 14,4 M 5,4 L 5,14 C 5,14.6 5.4,15 6,15 L 12,15 C 12.6,15 13,14.6 13,14 L 13,4 M 6,4 L 7,2 L 11,2 L 12,4 M 8,7 L 8,12 M 10,7 L 10,12" />
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Receipt queue" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Select one or several receipts"
                                       Margin="0,2,0,0"
                                       Style="{StaticResource SectionDescriptionTextStyle}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="8,0,8,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ListBox x:Name="ImageListBox"
                                         SelectionMode="Extended"
                                         SelectionChanged="ImageListBox_SelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0"
                                                         Width="9"
                                                         Height="9"
                                                         Fill="{Binding StatusBrush}"
                                                         VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Margin="0,2,0,0"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button x:Name="QueueAddReceiptButton"
                                        Content="+  Add receipt"
                                        Height="34"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource QueueAddButtonStyle}"
                                        Click="SelectImagesButton_Click" />

                                <StackPanel Margin="0,12,0,0"
                                            HorizontalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=ImageListBox}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="No receipts yet"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Choose files above or drop them here"
                                               Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Style="{StaticResource SectionDescriptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="ReceiptDropOverlay"
                                Visibility="Collapsed"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource RadiusMedium}"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Drop receipts to add"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentTextBrush}" />
                                <TextBlock Text="JPG, JPEG, PNG, or a folder"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Receipt preview -->
            <Border Grid.Column="2" Style="{StaticResource PrimaryWorkspacePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,13,16,11">
                        <TextBlock Text="Receipt preview" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="OCR regions and field references appear on the image"
                                   Margin="0,2,0,0"
                                   Style="{StaticResource SectionDescriptionTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="1,0,1,1"
                            Background="{StaticResource PreviewWorkspaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,11,11">
                        <Grid>
                            <ScrollViewer x:Name="ReceiptScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          SizeChanged="ReceiptScrollViewer_SizeChanged">
                                <Grid x:Name="ReceiptImageHost"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top">
                                    <Image x:Name="ReceiptImage"
                                           Stretch="Fill"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top" />
                                    <Canvas x:Name="OcrOverlayCanvas"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="True" />
                                </Grid>
                            </ScrollViewer>

                            <StackPanel Width="250"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=ReceiptImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="48"
                                        Height="48"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="24">
                                    <TextBlock Text="▧"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="22"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock Text="Select a receipt to preview"
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="The image and OCR highlights will appear here."
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Style="{StaticResource SectionDescriptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Review panel -->
            <Border Grid.Column="4" Style="{StaticResource WorkspaceColumnPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,13,16,7">
                        <TextBlock Text="Review" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Verify OCR text, then approve extracted fields"
                                   Margin="0,2,0,0"
                                   Style="{StaticResource SectionDescriptionTextStyle}" />
                    </StackPanel>

                    <TabControl x:Name="ReviewTabControl" Grid.Row="1" Margin="8,0,8,0">
                        <TabItem Header="OCR">
                            <Grid>
                                <ListBox x:Name="OcrResultListBox"
                                         Margin="0,6,0,0"
                                         SelectionChanged="OcrResultListBox_SelectionChanged"
                                         MouseDoubleClick="OcrResultListBox_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Index}"
                                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                                           Margin="2,0,8,0" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ConfidenceText}"
                                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding CorrectionStatus}"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="OCR results will appear after analysis."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionDescriptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=OcrResultListBox}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Fields">
                            <Grid>
                                <ListBox x:Name="FieldReviewListBox"
                                         Margin="0,6,0,0"
                                         SelectionChanged="FieldReviewListBox_SelectionChanged"
                                         PreviewMouseLeftButtonDown="FieldReviewListBox_PreviewMouseLeftButtonDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,5" MinHeight="36">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="0"
                                                          Grid.Column="1"
                                                          MinHeight="30"
                                                          Padding="6,2"
                                                          HorizontalContentAlignment="Stretch"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="True"
                                                          ItemsSource="{Binding Suggestions}"
                                                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          LostFocus="FieldValueComboBox_LostFocus"
                                                          SelectionChanged="FieldValueComboBox_SelectionChanged">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding ReviewNote}"
                                                           Margin="0,3,0,0"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Parsed fields will appear after OCR confirmation."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionDescriptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=FieldReviewListBox}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <Expander Grid.Row="2"
                              Header="Debug dump"
                              IsExpanded="False"
                              Margin="12,8,12,12">
                        <TextBox x:Name="DebugDumpTextBox"
                                 Height="180"
                                 FontFamily="{StaticResource AppMonospaceFontFamily}"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                </Grid>
            </Border>
        </Grid>

        <!-- Review actions -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12"
                Style="{StaticResource WorkspacePanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="Shortcuts: Shift+Enter confirm · Ctrl+Enter approve or roll back · Shift+↓ next receipt" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="16,0,0,0">
                    <Button x:Name="NextReceiptButton"
                            Content="Next Receipt"
                            Width="122"
                            Height="34"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="NextReceiptButton_Click" />
                    <Button x:Name="ConfirmOcrButton"
                            Content="Confirm OCR"
                            Width="122"
                            Height="34"
                            Margin="8,0,0,0"
                            Style="{StaticResource OcrReviewActionButtonStyle}"
                            Click="ConfirmOcrButton_Click" />
                    <Button x:Name="ApproveFieldsButton"
                            Content="Approve Fields"
                            Width="122"
                            Height="34"
                            Margin="8,0,0,0"
                            Style="{StaticResource FieldReviewActionButtonStyle}"
                            Click="ApproveFieldsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
