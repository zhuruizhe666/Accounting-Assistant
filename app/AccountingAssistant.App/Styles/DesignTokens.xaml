<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- Typography -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <system:Double x:Key="FontSizeCaption">11</system:Double>
    <system:Double x:Key="FontSizeBody">13</system:Double>
    <system:Double x:Key="FontSizeBodyLarge">14</system:Double>
    <system:Double x:Key="FontSizePanelTitle">16</system:Double>
    <system:Double x:Key="FontSizePageTitle">22</system:Double>

    <!-- Core palette -->
    <Color x:Key="AppBackgroundColor">#FF1E1F22</Color>
    <Color x:Key="SurfaceColor">#FF282A2F</Color>
    <Color x:Key="SurfaceSubtleColor">#FF24262B</Color>
    <Color x:Key="PreviewWorkspaceColor">#FF191A1E</Color>
    <Color x:Key="SurfaceHoverColor">#FF32343A</Color>
    <Color x:Key="SurfacePressedColor">#FF3A3C43</Color>
    <Color x:Key="BorderColor">#FF41434A</Color>
    <Color x:Key="BorderStrongColor">#FF595B64</Color>

    <Color x:Key="TextPrimaryColor">#FFE4E2E7</Color>
    <Color x:Key="TextSecondaryColor">#FFAAA7B0</Color>
    <Color x:Key="TextMutedColor">#FF817E88</Color>

    <Color x:Key="AccentColor">#FFA99BC8</Color>
    <Color x:Key="AccentHoverColor">#FFB8AAD2</Color>
    <Color x:Key="AccentPressedColor">#FF75688F</Color>
    <Color x:Key="AccentSoftColor">#FF383442</Color>
    <Color x:Key="AccentContrastColor">#FF1E1F22</Color>
    <Color x:Key="AccentTextColor">#FFC5B9DB</Color>
    <Color x:Key="FocusColor">#FFB8AAD2</Color>

    <Color x:Key="DisabledSurfaceColor">#FF303238</Color>
    <Color x:Key="DisabledTextColor">#FF706D77</Color>
    <Color x:Key="SuccessColor">#FF78C69A</Color>
    <Color x:Key="SuccessSoftColor">#FF24372D</Color>
    <Color x:Key="WarningColor">#FFE2B766</Color>
    <Color x:Key="WarningSoftColor">#FF3A3123</Color>
    <Color x:Key="DangerColor">#FFE27D78</Color>
    <Color x:Key="DangerHoverColor">#FFF08D87</Color>
    <Color x:Key="DangerPressedColor">#FFB95E5A</Color>
    <Color x:Key="DangerSoftColor">#FF3D292B</Color>

    <!-- Receipt workflow status palette; base colors match ReceiptImageItem.StatusBrush. -->
    <Color x:Key="PendingStatusColor">#FF77747D</Color>
    <Color x:Key="PendingStatusForegroundColor">#FFB8B5BE</Color>
    <Color x:Key="PendingStatusSoftColor">#FF303136</Color>
    <Color x:Key="OcrReviewStatusColor">#FFD0A45B</Color>
    <Color x:Key="OcrReviewStatusForegroundColor">#FFE8C47D</Color>
    <Color x:Key="OcrReviewStatusSoftColor">#FF392F22</Color>
    <Color x:Key="FieldReviewStatusColor">#FF6FB58C</Color>
    <Color x:Key="FieldReviewStatusForegroundColor">#FF8FD0A8</Color>
    <Color x:Key="FieldReviewStatusSoftColor">#FF23352B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
    <SolidColorBrush x:Key="PreviewWorkspaceBrush" Color="{StaticResource PreviewWorkspaceColor}" />
    <LinearGradientBrush x:Key="WorkspaceAmbientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF222328" />
        <GradientStop Offset="0.52" Color="#FF1E1F22" />
        <GradientStop Offset="1" Color="#FF1A1B1F" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="{StaticResource AccentContrastColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="PendingStatusBrush" Color="{StaticResource PendingStatusColor}" />
    <SolidColorBrush x:Key="PendingStatusForegroundBrush" Color="{StaticResource PendingStatusForegroundColor}" />
    <SolidColorBrush x:Key="PendingStatusSoftBrush" Color="{StaticResource PendingStatusSoftColor}" />
    <SolidColorBrush x:Key="OcrReviewStatusBrush" Color="{StaticResource OcrReviewStatusColor}" />
    <SolidColorBrush x:Key="OcrReviewStatusForegroundBrush" Color="{StaticResource OcrReviewStatusForegroundColor}" />
    <SolidColorBrush x:Key="OcrReviewStatusSoftBrush" Color="{StaticResource OcrReviewStatusSoftColor}" />
    <SolidColorBrush x:Key="FieldReviewStatusBrush" Color="{StaticResource FieldReviewStatusColor}" />
    <SolidColorBrush x:Key="FieldReviewStatusForegroundBrush" Color="{StaticResource FieldReviewStatusForegroundColor}" />
    <SolidColorBrush x:Key="FieldReviewStatusSoftBrush" Color="{StaticResource FieldReviewStatusSoftColor}" />

    <!-- Spacing and geometry -->
    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="ControlPadding">14,6</Thickness>
    <Thickness x:Key="CompactControlPadding">10,4</Thickness>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <system:Double x:Key="ControlHeight">32</system:Double>
    <system:Double x:Key="CompactControlHeight">28</system:Double>
</ResourceDictionary>
