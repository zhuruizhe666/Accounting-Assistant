<Window x:Class="AccountingAssistant.App.SuggestionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suggestions"
        Height="520"
        Width="560"
        MinHeight="460"
        MinWidth="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SuggestionTabControl">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Header="已有建议">
                            <DockPanel Margin="8">
                                <Button DockPanel.Dock="Bottom"
                                        Content="删除选中"
                                        Height="30"
                                        Width="96"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0"
                                        Click="DeleteSuggestionButton_Click" />
                                <ListBox ItemsSource="{Binding Values}"
                                         SelectionMode="Extended" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="新增建议" Margin="0,12,0,0">
                            <DockPanel Margin="8">
                                <Button DockPanel.Dock="Right"
                                        Content="新增"
                                        Width="80"
                                        Height="30"
                                        Margin="8,0,0,0"
                                        Click="AddSuggestionButton_Click" />
                                <TextBox x:Name="NewSuggestionTextBox"
                                         Height="30"
                                         VerticalContentAlignment="Center" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Save"
                    Width="88"
                    Height="30"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button Content="Cancel"
                    Width="88"
                    Height="30"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
